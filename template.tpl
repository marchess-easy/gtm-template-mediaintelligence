___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const sendPixel = require('sendPixel');
const localStorage = require('localStorage');
const log = require('logToConsole');
const callInWindow = require('callInWindow');
const encodeUriComponent = require('encodeUriComponent');

const tagType = data.tagType;

// Counter Tag Logic
if (tagType === 'counter') {
  const counterId = data.counterId;
  
  // Validate Counter ID
  if (!counterId || counterId === '') {
    log('Error: Counter ID is required');
    return data.gtmOnFailure();
  }
  
  const counterUrl = 'https://data.min-cdn.net/counter/' + encodeUriComponent(counterId) + '.js';
  log('Loading counter script: ' + counterUrl);
  
  injectScript(counterUrl, () => {
    log('Counter script loaded successfully.');
    data.gtmOnSuccess();
  }, data.gtmOnFailure, 'counterScript');
  
  return;
}

// Advertiser Tracking Logic
const advertiserId = data.advertiserId;

// Validate Advertiser ID
if (!advertiserId || advertiserId === '') {
  log('Error: Advertiser ID is required');
  return data.gtmOnFailure();
}

const trackingDomain = 'mediaintelligence.de';
const mode = data.trackingMode;

let mainContainerDone = false;
let standardDone = (mode !== 'standard' && mode !== 'both');
let basketDone = (mode !== 'basket' && mode !== 'both');

const checkDone = () => {
  if (mainContainerDone && standardDone && basketDone) {
    log('All tracking actions completed successfully.');
    data.gtmOnSuccess();
  }
};

const containerUrl = 'https://' + trackingDomain + '/trck/etms/eatms.js?advertiser_id=' + encodeUriComponent(advertiserId);
log('Loading general container.');
injectScript(containerUrl, () => {
  log('General container loaded.');
  mainContainerDone = true;
  checkDone();
}, data.gtmOnFailure, 'mainContainer');

if (mode === 'standard' || mode === 'both') {
  log('Executing standard tracking.');
  
  // Validate required fields
  if (!data.token || data.token === '') {
    log('Error: Order Number (token) is required for standard tracking');
    return data.gtmOnFailure();
  }
  if (!data.turnover || data.turnover === '') {
    log('Error: Revenue (turnover) is required for standard tracking');
    return data.gtmOnFailure();
  }
  
  const storageKey = 'emid';
  let trackId = localStorage.getItem(storageKey) || '';

  let trackingUrl = 'https://' + trackingDomain + '/trck/etrack/?' +
    'advertiser_id=' + encodeUriComponent(advertiserId) +
    '&trigger_id=' + encodeUriComponent(data.triggerId || '1') +
    '&token=' + encodeUriComponent(data.token) +
    '&turnover=' + encodeUriComponent(data.turnover) +
    '&currency=' + encodeUriComponent(data.currency || 'EUR') +
    '&descr=' + encodeUriComponent(data.descr || '') +
    '&t=js';
  if (trackId) {
    trackingUrl += '&trackid=' + encodeUriComponent(trackId);
  }
  
  sendPixel(trackingUrl, () => {
    log('Standard tracking pixel sent.');
    standardDone = true;
    checkDone();
  }, data.gtmOnFailure);
}

if (mode === 'basket' || mode === 'both') {
  log('Executing shopping cart tracking.');
  
  // Validate required fields
  if (!data.basketOrderToken || data.basketOrderToken === '') {
    log('Error: Order Token is required for basket tracking');
    return data.gtmOnFailure();
  }
  if (!data.basketTurnover || data.basketTurnover === '') {
    log('Error: Turnover is required for basket tracking');
    return data.gtmOnFailure();
  }
  
  const basketScriptUrl = 'https://' + trackingDomain + '/trck/ebasket/ebasket.js?' +
    'advertiser_id=' + encodeUriComponent(advertiserId) +
    '&trigger_id=' + encodeUriComponent(data.triggerId || '1') +
    '&ordertoken=' + encodeUriComponent(data.basketOrderToken) +
    '&turnover=' + encodeUriComponent(data.basketTurnover) +
    '&descr=basket_failover';
    
  injectScript(basketScriptUrl, () => {
    log('ebasket.js loaded. Processing shopping cart items.');
    
    callInWindow('eamTrckClearBasket');
    
    if (data.basketItems) {
      data.basketItems.forEach(item => {
        const itemOptions = {
          'vc': item.voucher || 'VOUCHER',
          'currency': item.currency || 'EUR'
        };
        
        callInWindow(
          'eamTrckAddBasketItemByAdvertiserId',
          advertiserId,
          data.basketOrderToken,
          data.triggerId || 1,
          item.articleNumber,
          item.amount,
          item.price,
          item.actionId || '',
          item.productName,
          item.category,
          itemOptions
        );
      });
    }
    
    callInWindow('eamTrckSubmitBasket');
    callInWindow('eamTrckClearBasket');
    
    log('Shopping cart submitted.');
    basketDone = true;
    checkDone();
    
  }, data.gtmOnFailure, 'basketScript');
}


